{
  "name": "ai-chat-outline-extension",
  "version": "1.0.18",
  "description": "A cross-browser extension providing interactive conversation outlines and quick scrolling navigation for AI platforms like Gemini, ChatGPT, and Kimi.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit": "wxt submit",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "wxt": "^0.19.1"
  }
}
